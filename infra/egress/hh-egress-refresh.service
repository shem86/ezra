[Unit]
Description=hh-assistant egress allowlist REFRESH (re-resolve CDN IPs into the live nft sets)
Documentation=file:///home/hh/hh-assistant/infra/runtime.md
# refresh only ADDS nft set ELEMENTS while the table/chain stay loaded
# (V2_NOTES §11) — no fail-open window, unlike `apply` which deletes the table
# first. It therefore requires the table to already exist, so it is ordered
# after the boot-time apply (hh-egress.service); at periodic firings the table
# persists in the kernel and this just re-resolves the rotating IPs.
#
# `After=` ONLY — never `Wants=hh-egress.service`. hh-egress.service is a
# oneshot without RemainAfterExit, so systemd sees it as inactive between runs
# and a `Wants=` pulls a full `apply` (table delete + rebuild) in front of EVERY
# timer tick: the journal showed "applied table" 1s before each "refreshed"
# line. That silently re-opened the fail-open window §11 was meant to close AND
# wiped the accumulated set right before refresh re-added the current answers,
# so the rotating oauth2.googleapis.com record was still dropped (STATUS.md item
# 8, 2026-09-03). If the table is missing, `nft add element` fails and this unit
# fails loudly instead — the right outcome.
After=docker.service hh-egress.service

[Service]
Type=oneshot
# Same STATIC bridge name as the apply unit (pinned in docker-compose.prod.yml,
# V2_NOTES §5), then `refresh` instead of `apply`.
Environment=EGRESS_IFACE=hh-egress0
ExecStart=/usr/bin/env bash /home/hh/hh-assistant/infra/egress/nftables.sh refresh
